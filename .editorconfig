# Vrem - Unreal Engine 5.7 project
# 소스 인코딩을 UTF-8로 고정한다. Visual Studio / Rider 가 시스템
# 로케일(CP949)로 저장해 한글 주석이 깨지는 것을 막기 위한 것이다.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp,cs}]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
